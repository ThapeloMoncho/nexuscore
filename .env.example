# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL / SITE_URL: Public canonical URL for SEO and email links
NEXT_PUBLIC_SITE_URL=

# Supabase Configuration (Server-side persistence for contacts and quote requests)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Email Configuration (Server-side notifications & customer confirmations)
RESEND_API_KEY=
BUSINESS_EMAIL=
SMTP_FROM=

# Editable Business Contact Placeholder
WHATSAPP_NUMBER=
